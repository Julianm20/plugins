# ===========================================================================
#  Trait SMP Discord bot
#  Copy this file to .env and fill it in. NEVER commit .env.
# ===========================================================================

# --- Discord (required) ----------------------------------------------------
# Bot token from https://discord.com/developers/applications -> Bot -> Reset Token
DISCORD_TOKEN=
# Right-click your Discord server -> Copy Server ID (needs Developer Mode on)
DISCORD_GUILD_ID=

# --- Status channel --------------------------------------------------------
# Right-click #server-status -> Copy Channel ID.
# Leave blank and run /setup-status in the channel instead - the bot saves it.
STATUS_CHANNEL_ID=

# --- Minecraft server ------------------------------------------------------
MINECRAFT_HOST=traitsmp.duckdns.org
MINECRAFT_PORT=25565
# Give up on a query after this long, so the monitor loop can never hang.
MINECRAFT_TIMEOUT=5000

# --- Monitoring ------------------------------------------------------------
# Seconds between checks.
STATUS_INTERVAL=60
# Shown as the maximum until the server reports its own value.
MAX_PLAYERS=50
# Consecutive failed checks before the server is called offline.
# 1 failure = "unknown", so a single dropped packet does not flip the embed.
OFFLINE_FAILURE_THRESHOLD=2

# --- Optional: state change notifications ----------------------------------
STATUS_NOTIFICATIONS=false
# Where to post them. Defaults to the status channel when blank.
NOTIFICATION_CHANNEL_ID=

# --- Cosmetic --------------------------------------------------------------
SERVER_NAME=TRAIT SMP
EMBED_FOOTER=Trait SMP • Season 1

# --- Logging ---------------------------------------------------------------
# debug | info | warn | error
LOG_LEVEL=info
