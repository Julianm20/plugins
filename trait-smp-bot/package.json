{
  "name": "trait-smp-bot",
  "version": "1.0.0",
  "private": true,
  "description": "Discord bot for the Trait SMP Minecraft server.",
  "main": "dist/index.js",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsc --watch",
    "deploy": "npm run build && node dist/deploy-commands.js",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "discord.js": "^14.27.0",
    "dotenv": "^17.4.2",
    "minecraft-server-util": "^5.4.4"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "typescript": "^5.9.3"
  }
}
